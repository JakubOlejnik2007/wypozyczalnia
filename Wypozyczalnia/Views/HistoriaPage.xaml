<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Wypozyczalnia.Views.HistoriaPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Style="{StaticResource Strona}"
             Title="Historia wypożyczeń">

    <Grid RowDefinitions="Auto,Auto,*" Padding="32" RowSpacing="16">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="Historia wypożyczeń" Style="{StaticResource Tytul}" />
            <Label Text="Wszystkie wypożyczenia – aktywne i zakończone."
                   Style="{StaticResource Podtytul}" />
        </VerticalStackLayout>

        <!-- Filtry -->
        <Grid Grid.Row="1" ColumnDefinitions="*,180,170,170,Auto" ColumnSpacing="12">
            <SearchBar x:Name="SzukajSearchBar" Grid.Column="0" Placeholder="Szukaj po osobie lub sprzęcie…" />
            <Picker x:Name="StatusPicker" Grid.Column="1" Title="Każdy status" VerticalOptions="Center" />
            <DatePicker x:Name="OdDatePicker" Grid.Column="2" VerticalOptions="Center" />
            <DatePicker x:Name="DoDatePicker" Grid.Column="3" VerticalOptions="Center" />
            <Button x:Name="FiltrujButton" Grid.Column="4" Text="Filtruj" Style="{StaticResource PrzyciskGlowny}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Karta}" Padding="0">
            <Grid RowDefinitions="Auto,*">

                <Grid Grid.Row="0" ColumnDefinitions="60,*,*,160,160,*,130" Padding="20,14" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="NR"          Style="{StaticResource NaglowekKolumny}" />
                    <Label Grid.Column="1" Text="SPRZĘT"      Style="{StaticResource NaglowekKolumny}" />
                    <Label Grid.Column="2" Text="OSOBA"       Style="{StaticResource NaglowekKolumny}" />
                    <Label Grid.Column="3" Text="WYPOŻYCZONO" Style="{StaticResource NaglowekKolumny}" />
                    <Label Grid.Column="4" Text="ZWRÓCONO"    Style="{StaticResource NaglowekKolumny}" />
                    <Label Grid.Column="5" Text="NOTATKA"     Style="{StaticResource NaglowekKolumny}" />
                    <Label Grid.Column="6" Text="STATUS"      Style="{StaticResource NaglowekKolumny}" />
                </Grid>

                <CollectionView x:Name="HistoriaCollection" Grid.Row="1" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Brak wypożyczeń."
                               Style="{StaticResource Podtytul}"
                               HorizontalOptions="Center" Margin="0,60" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="60,*,*,160,160,*,130" Padding="20,10" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="{Binding id}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding sprzet}" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding osoba}" VerticalOptions="Center" />
                                <Label Grid.Column="3" Text="{Binding data_wypozyczenia, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="4" Text="{Binding data_zwrotu, StringFormat='{0:dd.MM.yyyy HH:mm}', TargetNullValue='—'}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="5" Text="{Binding notatka}" LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" />

                                <!-- Plakietka: niebieska = aktywne, zielona = zakończone -->
                                <Border Grid.Column="6" Style="{StaticResource Plakietka}"
                                        BackgroundColor="{StaticResource Sukces}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding status}" Value="aktywne">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Akcent}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Style="{StaticResource PlakietkaTekst}" Text="{Binding status}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
