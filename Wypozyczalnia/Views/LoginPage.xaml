<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Wypozyczalnia.Views.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Style="{StaticResource Strona}"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False"
             Title="Logowanie">

    <!-- Usunąć Shell.FlyoutBehavior="Disabled", aby zobaczyć widok po zalogowaniu -->

    <Grid Padding="24">
        <Border Style="{StaticResource Karta}"
                WidthRequest="420"
                Padding="32"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <VerticalStackLayout Spacing="4">

                <Label Text="📦" FontSize="44" HorizontalOptions="Center" />
                <Label Text="Wypożyczalnia sprzętu"
                       Style="{StaticResource Tytul}"
                       HorizontalOptions="Center" />
                <Label Text="Zaloguj się jako operator"
                       Style="{StaticResource Podtytul}"
                       HorizontalOptions="Center"
                       Margin="0,0,0,12" />

                <Label Text="Login" Style="{StaticResource Etykieta}" />
                <Entry x:Name="LoginEntry" Placeholder="np. operator1" ReturnType="Next" />

                <Label Text="Hasło" Style="{StaticResource Etykieta}" />
                <Entry x:Name="HasloEntry" Placeholder="••••••••" IsPassword="True" ReturnType="Done" />

                <!-- Komunikat o błędzie logowania (pokazywany z kodu) -->
                <Label x:Name="BladLabel"
                       Text="Nieprawidłowy login lub hasło."
                       TextColor="{StaticResource Ostrzezenie}"
                       FontSize="13"
                       IsVisible="False"
                       Margin="0,8,0,0" />

                <Button x:Name="ZalogujButton"
                        Text="Zaloguj"
                        Style="{StaticResource PrzyciskGlowny}"
                        Margin="0,20,0,0" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
